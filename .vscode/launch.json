{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rust: native smoke",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/examples/native_smoke",
      "args": [
        "${workspaceFolder}/.jfquant/runs/native-smoke"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Rust: native smoke build",
      "env": {
        "LIGHTGBM_LIB_DIR": "${env:LIGHTGBM_LIB_DIR}",
        "DYLD_LIBRARY_PATH": "${env:LIGHTGBM_LIB_DIR}:${env:DYLD_LIBRARY_PATH}"
      }
    },
    {
      "name": "Rust: desktop app",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/analytics-desktop",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Rust: build desktop app",
      "preRunCommands": [
        "script [bp.SetEnabled(False) for bp in lldb.debugger.GetSelectedTarget().breakpoint_iter() if bp.MatchesName('cpp_exception')]"
      ]
    },
    {
      "name": "Rust: jfquant CLI",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/jfquant",
      "args": [
        "--help"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Rust: build jfquant CLI"
    }
  ]
}
