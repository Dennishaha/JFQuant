{
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--workspace", "--all-targets", "--", "-D", "warnings"],
  "jfquant.lightgbmLibDir": "${env:LIGHTGBM_LIB_DIR}",
  "jfquant.duckdbDownloadLib": "1",
  "jfquant.marketPath": "${workspaceFolder}/data/market",
  "jfquant.universePath": "${workspaceFolder}/data/universe",
  "jfquant.outputPath": "${workspaceFolder}/.jfquant/runs/latest",
  "files.exclude": {
    "**/target": true,
    "**/.jfquant": true
  }
}
