+    fn configure_jfquant_rights(&mut self, payload: &str) -> PyResult<()> {
+        if self.current_date.is_some() { return Err(pyo3::exceptions::PyValueError::new_err("rights configuration after start")); }
+        let ledger: crate::rights_account::Ledger = serde_json::from_str(payload).map_err(|e|pyo3::exceptions::PyValueError::new_err(e.to_string()))?;
+        if !ledger.states.is_empty() || ledger.date.is_some() || !ledger.closes.is_empty() || !ledger.audit.is_empty() {
+            return Err(pyo3::exceptions::PyValueError::new_err("rights initial state must be empty"));
+        }
+        ledger.validate().map_err(pyo3::exceptions::PyValueError::new_err)?;
+        self.state.portfolio.rights = std::sync::Arc::new(ledger);
+        Ok(())
+    }
+
+    fn jfquant_rights_state(&self) -> PyResult<String> {
+        serde_json::to_string(&self.state.portfolio.rights).map_err(|e|pyo3::exceptions::PyValueError::new_err(e.to_string()))
+    }
