{
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--workspace", "--all-targets", "--", "-D", "warnings"],
  "extensions.ignoreRecommendations": false,
  "jfquant.duckdbDownloadLib": "1",
  "jfquant.marketPath": "data/market",
  "jfquant.universePath": "data/universe",
  "jfquant.outputPath": ".jfquant/runs/latest",
  "files.exclude": {
    "**/target": true,
    "**/.jfquant": true
  }
}
