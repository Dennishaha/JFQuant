#!/bin/bash
# JFQuant 开发便捷工具
# 提供常用开发命令的统一接口

set -euo pipefail

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# 帮助信息
show_help() {
    cat << EOF
${BLUE}JFQuant 开发工具${NC}

用法: ./scripts/dev <command> [options]

${GREEN}快速检查命令：${NC}
  check           运行快速代码检查（格式化 + lint + 架构）
  fmt             格式化所有代码（Rust + Python）
  lint            运行 Clippy 和 Ruff lint
  arch            验证架构依赖关系

${GREEN}测试命令：${NC}
  test [crate]    运行测试（可选指定 crate 名称）
  test-fast       仅运行快速单元测试
  test-golden     运行 golden tests
  watch           监视模式自动运行测试

${GREEN}覆盖率和基准测试：${NC}
  cov             生成测试覆盖率报告并打开 HTML
  bench [crate]   运行性能基准测试

${GREEN}发布前检查：${NC}
  release         完整发布前检查清单
  verify          运行所有验证脚本

${GREEN}示例：${NC}
  ./scripts/dev check               # 快速检查（5-10 秒）
  ./scripts/dev test storage        # 测试 storage crate
  ./scripts/dev watch               # 监视模式
  ./scripts/dev cov                 # 生成覆盖率报告
  ./scripts/dev release             # 发布前完整检查

EOF
}

# 快速检查
cmd_check() {
    echo -e "${BLUE}🔍 运行快速检查...${NC}"

    echo -e "\n${YELLOW}[1/4] 检查 Rust 格式化${NC}"
    cargo fmt --all -- --check

    echo -e "\n${YELLOW}[2/4] 检查 Python 格式化${NC}"
    python3 -m ruff format --check crates/

    echo -e "\n${YELLOW}[3/4] 运行 Clippy${NC}"
    cargo clippy --all-targets --all-features -- -D warnings

    echo -e "\n${YELLOW}[4/4] 验证架构依赖${NC}"
    python3 crates/workflow/checks/architecture.py

    echo -e "\n${GREEN}✅ 所有检查通过！${NC}"
}

# 格式化代码
cmd_fmt() {
    echo -e "${BLUE}🎨 格式化代码...${NC}"

    echo -e "\n${YELLOW}格式化 Rust 代码${NC}"
    cargo fmt --all

    echo -e "\n${YELLOW}格式化 Python 代码${NC}"
    python3 -m ruff format crates/

    echo -e "\n${GREEN}✅ 代码格式化完成！${NC}"
}

# Lint 检查
cmd_lint() {
    echo -e "${BLUE}🔬 运行 Lint 检查...${NC}"

    echo -e "\n${YELLOW}Rust Clippy${NC}"
    cargo clippy --all-targets --all-features -- -D warnings

    echo -e "\n${YELLOW}Python Ruff${NC}"
    python3 -m ruff check crates/

    echo -e "\n${GREEN}✅ Lint 检查完成！${NC}"
}

# 架构验证
cmd_arch() {
    echo -e "${BLUE}🏗️  验证架构依赖...${NC}"
    python3 crates/workflow/checks/architecture.py
    echo -e "${GREEN}✅ 架构依赖验证通过！${NC}"
}

# 运行测试
cmd_test() {
    if [ -n "${1:-}" ]; then
        echo -e "${BLUE}🧪 测试 jfquant-$1...${NC}"
        cargo nextest run -p "jfquant-$1"
    else
        echo -e "${BLUE}🧪 运行所有测试...${NC}"
        cargo nextest run --workspace
    fi
}

# 快速测试（仅单元测试）
cmd_test_fast() {
    echo -e "${BLUE}⚡ 运行快速单元测试...${NC}"
    cargo nextest run --lib --bins
}

# Golden tests
cmd_test_golden() {
    echo -e "${BLUE}🎯 运行 golden tests...${NC}"
    cargo test --test golden_tests
}

# 监视模式
cmd_watch() {
    if ! command -v cargo-watch &> /dev/null; then
        echo -e "${RED}❌ cargo-watch 未安装${NC}"
        echo "安装: cargo install cargo-watch"
        exit 1
    fi

    echo -e "${BLUE}👀 启动监视模式...${NC}"
    cargo watch -x "nextest run --lib"
}

# 覆盖率报告
cmd_cov() {
    if ! command -v cargo-llvm-cov &> /dev/null; then
        echo -e "${RED}❌ cargo-llvm-cov 未安装${NC}"
        echo "安装: cargo install cargo-llvm-cov"
        exit 1
    fi

    echo -e "${BLUE}📊 生成覆盖率报告...${NC}"
    cargo llvm-cov nextest --html --open
    echo -e "${GREEN}✅ 覆盖率报告已生成并打开！${NC}"
}

# 基准测试
cmd_bench() {
    echo -e "${BLUE}⚡ 运行基准测试...${NC}"

    if [ -n "${1:-}" ]; then
        cargo bench -p "jfquant-$1"
    else
        cargo bench --workspace
    fi
}

# 发布前检查
cmd_release() {
    echo -e "${BLUE}🚀 运行发布前检查清单...${NC}"

    echo -e "\n${YELLOW}[1/6] 格式化检查${NC}"
    cargo fmt --all -- --check
    python3 -m ruff format --check crates/

    echo -e "\n${YELLOW}[2/6] Lint 检查${NC}"
    cargo clippy --all-targets --all-features -- -D warnings

    echo -e "\n${YELLOW}[3/6] 架构验证${NC}"
    python3 crates/workflow/checks/architecture.py

    echo -e "\n${YELLOW}[4/6] 运行所有测试${NC}"
    cargo nextest run --workspace --release

    echo -e "\n${YELLOW}[5/6] Release 构建${NC}"
    cargo build --release --workspace

    echo -e "\n${YELLOW}[6/6] 打包验证${NC}"
    if [ -f "./crates/app/packaging/verify-bundle.sh" ]; then
        ./crates/app/packaging/verify-bundle.sh
    else
        echo "跳过：打包验证脚本不存在"
    fi

    echo -e "\n${GREEN}✅ 所有发布检查通过！可以发布了。${NC}"
}

# 完整验证
cmd_verify() {
    echo -e "${BLUE}🔍 运行完整验证...${NC}"

    if [ -f "./scripts/verify-setup.sh" ]; then
        ./scripts/verify-setup.sh
    else
        echo -e "${YELLOW}⚠️  verify-setup.sh 不存在，运行基础检查${NC}"
        cmd_check
        cmd_test
    fi
}

# 主程序
case "${1:-help}" in
    check)
        cmd_check
        ;;
    fmt|format)
        cmd_fmt
        ;;
    lint)
        cmd_lint
        ;;
    arch|architecture)
        cmd_arch
        ;;
    test)
        cmd_test "${2:-}"
        ;;
    test-fast)
        cmd_test_fast
        ;;
    test-golden)
        cmd_test_golden
        ;;
    watch)
        cmd_watch
        ;;
    cov|coverage)
        cmd_cov
        ;;
    bench|benchmark)
        cmd_bench "${2:-}"
        ;;
    release)
        cmd_release
        ;;
    verify)
        cmd_verify
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}❌ 未知命令: $1${NC}"
        echo ""
        show_help
        exit 1
        ;;
esac
