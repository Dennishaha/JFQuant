{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "DUCKDB_DOWNLOAD_LIB": "${config:jfquant.duckdbDownloadLib}",
      "LIGHTGBM_LIB_DIR": "${env:LIGHTGBM_LIB_DIR}",
      "DYLD_LIBRARY_PATH": "${env:LIGHTGBM_LIB_DIR}:${env:DYLD_LIBRARY_PATH}"
    }
  },
  "tasks": [
    {
      "label": "Rust: desktop interaction tests (nextest)",
      "type": "shell",
      "command": "cargo nextest run -p analytics-desktop",
      "problemMatcher": "$rustc",
      "group": "test"
    },
    {
      "label": "Rust: workspace tests",
      "type": "shell",
      "command": "cargo nextest run --workspace",
      "problemMatcher": "$rustc",
      "group": "test"
    },
    {
      "label": "Rust: workspace clippy",
      "type": "shell",
      "command": "cargo clippy --workspace --all-targets -- -D warnings",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: format check",
      "type": "shell",
      "command": "cargo fmt --all -- --check",
      "problemMatcher": []
    },
    {
      "label": "Rust: native smoke build",
      "type": "shell",
      "command": "cargo build -p analytics-ml --features lightgbm-native --example native_smoke",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: build desktop app",
      "type": "shell",
      "command": "cargo build -p analytics-desktop -p analytics-cli",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: run native smoke (terminal)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "analytics-ml",
        "--features",
        "lightgbm-native",
        "--example",
        "native_smoke",
        "--",
        "${workspaceFolder}/.jfquant/runs/native-smoke"
      ],
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: run desktop app (terminal)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "-p",
        "analytics-desktop"
      ],
      "dependsOn": "Rust: build desktop app",
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: build jfquant CLI",
      "type": "shell",
      "command": "cargo build -p analytics-cli",
      "problemMatcher": "$rustc"
    }
  ]
}
